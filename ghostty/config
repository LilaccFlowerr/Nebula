# Use the font we installed for Tide boxes
font-family = "JetBrainsMono Nerd Font"
font-size = 13

# Clean window aesthetics (Padding adds space around your text)
window-padding-x = 12
window-padding-y = 12

# Subtle transparency (set between 0.0 and 1.0)
# Corrected transparency settings
background-opacity = 0.90
background-blur = true


# Colors generated by matugen from the wallpaper (ghostty/themes/matugen)
theme = matugen
